PORT=4000
# Change the password for anything beyond a local demo (and in create-db.sql / ALTER USER).
DATABASE_URL=postgres://returnguard:returnguard@localhost:5432/returnguard

# Network address the API listens on. 127.0.0.1 = this computer only.
# The API has no login yet, so only widen this behind authentication.
# HOST=127.0.0.1

# Host names the API answers to (comma-separated). Blocks DNS-rebinding attacks.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origins allowed to call the API from a browser (comma-separated). Leave unset
# when using the bundled web app, which goes through the Vite proxy.
# CORS_ORIGINS=
